// FinTrack Pro - Prisma Schema
// Safe floating-point handling: amounts are stored as standard numbers with integer-cent normalization
// Fully compatible with SQLite (default zero-setup) and PostgreSQL for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  currency  String   @default("IDR") // IDR, USD, SGD
  pinCode   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallets               Wallet[]
  categories            Category[]
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
  savingsGoals          SavingsGoal[]
  splitBills            SplitBill[]
}

model Wallet {
  id        String   @id @default(cuid())
  userId    String
  name      String // e.g. "BCA Tabungan", "Tunai", "GoPay"
  type      String // CASH, BANK, E_WALLET, CREDIT_CARD, INVESTMENT
  balance   Float    @default(0)
  color     String   @default("#3b82f6")
  icon      String   @default("wallet")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]          @relation("SourceWallet")
  destinationTransfers  Transaction[]          @relation("DestinationWallet")
  recurringTransactions RecurringTransaction[] @relation("RecurringSourceWallet")
  recurringTransfers    RecurringTransaction[] @relation("RecurringDestinationWallet")
  savingsGoals          SavingsGoal[]
}

model Category {
  id        String   @id @default(cuid())
  userId    String
  name      String
  type      String // INCOME, EXPENSE
  color     String   @default("#64748b")
  icon      String   @default("tag")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions          Transaction[]
  budgets               Budget[]
  recurringTransactions RecurringTransaction[]
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  type        String // INCOME, EXPENSE, TRANSFER
  amount      Float
  date        DateTime
  notes       String?
  receiptUrl  String? // Data URL or base64 preview
  isRecurring Boolean  @default(false)

  // Relations
  categoryId          String?
  walletId            String // Source wallet
  destinationWalletId String? // Destination wallet if type == TRANSFER

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  wallet            Wallet    @relation("SourceWallet", fields: [walletId], references: [id], onDelete: Cascade)
  destinationWallet Wallet?   @relation("DestinationWallet", fields: [destinationWalletId], references: [id], onDelete: SetNull)
}

model Budget {
  id             String @id @default(cuid())
  userId         String
  categoryId     String
  amount         Float // Monthly budget ceiling
  month          Int // 1 - 12
  year           Int // e.g. 2026
  alertThreshold Float  @default(0.8) // 0.8 = 80%

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, categoryId, month, year])
}

model RecurringTransaction {
  id          String    @id @default(cuid())
  userId      String
  name        String // e.g. "Gaji Bulanan", "Sewa Apartemen", "Netflix"
  type        String // INCOME, EXPENSE, TRANSFER
  amount      Float
  frequency   String // DAILY, WEEKLY, MONTHLY, YEARLY
  startDate   DateTime
  nextRunDate DateTime
  lastRunDate DateTime?
  isActive    Boolean   @default(true)
  notes       String?

  categoryId          String?
  walletId            String
  destinationWalletId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category          Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  wallet            Wallet    @relation("RecurringSourceWallet", fields: [walletId], references: [id], onDelete: Cascade)
  destinationWallet Wallet?   @relation("RecurringDestinationWallet", fields: [destinationWalletId], references: [id], onDelete: SetNull)
}

model SavingsGoal {
  id            String    @id @default(cuid())
  userId        String
  name          String // e.g. "Dana Darurat", "Beli MacBook M3"
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  color         String    @default("#10b981")
  icon          String    @default("target")
  walletId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet Wallet? @relation(fields: [walletId], references: [id], onDelete: SetNull)
}

model SplitBill {
  id                String   @id @default(cuid())
  userId            String
  title             String
  totalAmount       Float
  myShare           Float
  participantsCount Int
  status            String   @default("SETTLED") // SETTLED, PENDING
  details           String? // JSON representation of participant items
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
